# Environments & Virtual Envs
venv/
.venv/
env/
.env
.env.*
*.env
backend/.env
# Do not ignore template example files
!.env.example
!*.env.example
!backend/.env.example

# Credentials, Keys & Sensitive Files (STRICT ZERO-SECRETS POLICY)
ee-credentials.json
backend/ee-credentials.json
*credential*.json
*credentials*.json
*.key
*.pem
*.pfx
*.p12

# Python artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node / Next.js / Frontend
node_modules/
build/
dist/
.next/
out/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor configurations
.vscode/
.idea/

# Large Datasets & Binary Dumps (Do not commit massive satellite/well data)
*.csv
*.tif
*.tiff
*.geojson
*.sqlite
*.sqlite3
*.db
*.parquet