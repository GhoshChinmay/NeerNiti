# ==============================================================================
# NeerNiti Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' to git!
# ==============================================================================

# Database Credentials (PostgreSQL 15+ with PostGIS 3.3+)
POSTGRES_USER=neerniti_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=neerniti_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Google Earth Engine (GEE) Service Account
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/path/to/your/gee-credentials.json

# NASA Earthdata / External API Logins
NASA_EARTHDATA_USERNAME=your_username
NASA_EARTHDATA_PASSWORD=your_password

# LLM Advisory Service (Optional - for SHAP civic explanation narrative)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=openrouter

# Backend Service Configuration
API_V1_STR=/api/v1
PROJECT_NAME=NeerNiti
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]